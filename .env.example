# Copy to .env and fill in your local values.

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:2003

# MySQL — the "skillbridge" database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillbridge

# Auth — change this to a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
