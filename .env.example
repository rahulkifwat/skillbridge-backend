# Copy to .env and fill in your local values.

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:2003

# MongoDB connection string. Atlas gives you this under "Connect → Drivers".
# The database name goes in the path (".../skillbridge"), or set MONGODB_DB.
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
# MONGODB_DB=skillbridge

# Auth — change this to a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
