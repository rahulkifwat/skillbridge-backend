# Copy to .env and fill in your local values.

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:2003

# MongoDB connection string. Atlas gives you this under "Connect → Drivers".
# The database name goes in the path (".../skillbridge"), or set MONGODB_DB.
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
# MONGODB_DB=skillbridge

# Auth — change this to a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Stripe (Spanish Academy checkout on /spanish/assessment)
# Test keys: https://dashboard.stripe.com/test/apikeys
FRONTEND_ORIGIN=http://localhost:2003
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional. stripe listen --forward-to localhost:5000/api/spanish/billing/webhook
STRIPE_WEBHOOK_SECRET=

# World-class production APIs — leave blank to use Loop Core + curriculum engine.
# Funded token budget for active development is approximately $50–$100 / month.
AI_MONTHLY_BUDGET_USD=75
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
HEYGEN_API_KEY=
SYNTHESIA_API_KEY=
ELEVENLABS_API_KEY=
VIDEO_ASSET_BUCKET_URL=
